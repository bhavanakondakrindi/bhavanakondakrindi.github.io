# ==============================================================================
# BHAVANA KONDAKRINDI PORTFOLIO — ENVIRONMENT VARIABLES
# ==============================================================================
# Rename this file to .env.local for local development.
# When deploying to GitHub Pages, you can use these keys with Supabase.
#
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (SAFE to be public in browser)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
